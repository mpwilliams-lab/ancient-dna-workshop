{
  "name": "ancient-dna-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ancient DNA of Britain: a terminal-style workshop app (WWU Homeschool Visitation Days, Oct 2026)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:fixture": "vite build --mode fixture",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync-data": "node scripts/sync-data.mjs",
    "check-data": "REAL_DATA=1 vitest run tests/real-data.test.ts",
    "prebuild": "node scripts/make-qr.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/qrcode": "1.5.6",
    "jsdom": "30.1.1",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3"
  }
}
