{
  "name": "ancient-dna-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ancient DNA of Britain: a terminal-style workshop app (WWU Homeschool Visitation Days, Oct 2026)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:fixture": "vite build --mode fixture",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync-data": "node scripts/sync-data.mjs",
    "check-data": "REAL_DATA=1 vitest run tests/real-data.test.ts tests/cardView.test.ts tests/plots-consumer.test.ts tests/runsheet.test.ts tests/runsheet-content.test.ts",
    "prebuild": "node scripts/make-qr.mjs",
    "e2e": "npm run build && playwright test",
    "export-offline": "npm run build && node scripts/export-offline.mjs",
    "run-sheet": "vite build --ssr scripts/runsheet-cli.ts --outDir .runsheet --emptyOutDir && node .runsheet/runsheet-cli.js",
    "preview-maps": "vite build --ssr scripts/preview-maps.ts --outDir .preview-maps --emptyOutDir && node .preview-maps/preview-maps.js",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "promote-assets": "node scripts/fetch-assets.mjs --promote",
    "credits": "node scripts/make-credits.mjs",
    "check-release": "vite build --ssr scripts/check-release.ts --outDir .release-check --emptyOutDir && node .release-check/check-release.js",
    "visual-check": "node scripts/visual-check.mjs",
    "make-map": "node scripts/make-map.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "jsdom": "30.1.1",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "qrcode": "1.5.4",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3"
  }
}
